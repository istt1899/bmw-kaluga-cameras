{
  "name": "marku_kaluga_cameras",
  "version": "0.1.2",
  "description": "Стендовый кандидат предупреждений камер Калужской области для BMW ID7",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 15,
    "memoryThresholdKB": 65536,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "MKCA",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "Marku custom local project",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true,
  "productName": "Камеры • Калуга",
  "mguHmi": [
    "ID7"
  ]
}
